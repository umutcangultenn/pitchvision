# PitchVision Lite - .env.example

# --- Backend Config ---
PROJECT_NAME="PitchVision Lite"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pitchvision
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchvision

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage_data

# --- Frontend Config ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
