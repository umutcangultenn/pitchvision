# PitchVision - Environment Variables Example

# --- Backend Config ---
PROJECT_NAME="PitchVision"
VERSION="1.0.0"
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL="postgresql://pitchvision:pitchvision_dev_password@localhost:5432/pitchvision_lite"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# MinIO / Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_BUCKET="pitchvision-videos"
MINIO_USE_SSL=false

# CV Pipeline
CV_MOCK_MODE=false
CV_MODEL_PATH="/models/yolov8n.pt"
FFMPEG_PATH="/usr/bin/ffmpeg"

# File Upload
UPLOAD_DIR="./uploads"

# NVIDIA NIM API (Llama 3.1 70B)
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY="your-nvidia-api-key-here"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_TIMEOUT=120

# Engine — Field dimensions
FIELD_TYPE="hali_saha"
HALI_SAHA_LENGTH=50.0
HALI_SAHA_WIDTH=30.0
FULL_PITCH_LENGTH=105.0
FULL_PITCH_WIDTH=68.0
SEGMENT_DURATION_MINUTES=15

# Engine — Detection thresholds
MOMENT_DETECTION_CONFIDENCE_THRESHOLD=0.4
COMPARISON_TIME_WINDOW_SECONDS=10.0

# AI Safety Rules
AI_DISCLAIMER="Bu analiz otomatik olarak üretilmiştir ve kesin doğruluk iddiası taşımaz. Nihai değerlendirme analist gözlemiyle birlikte yapılmalıdır."
AI_MAX_CONFIDENCE_CLAIM=0.85

# Environment
ENVIRONMENT="development"
DEBUG=true

# --- Frontend Config ---
NEXT_PUBLIC_API_URL=http://localhost:8000
