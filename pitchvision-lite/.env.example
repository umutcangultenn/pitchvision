# ─────────────────────────────────────────────────────────────────────────────
# PitchVision Lite — ortam değişkenleri
# Kullanım: cp .env.example .env  →  değerleri düzenle  →  docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
APP_NAME=PitchVision Lite API
DEBUG=false

# Üretimde güçlü, rastgele bir değer kullanın:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# JWT token geçerlilik süresi (dakika)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Docker Compose içinde servis adı "postgres" kullanılır
DATABASE_URL=postgresql+psycopg2://pitchvision:pitchvision@postgres:5432/pitchvision

# Yerel geliştirme (Docker olmadan):
# DATABASE_URL=postgresql+psycopg2://pitchvision:pitchvision@localhost:5432/pitchvision

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Yerel geliştirme (Docker olmadan):
# REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Virgülle ayrılmış origin listesi; boş veya * ise tüm origin'lere izin verilir
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Tarayıcıdan erişilebilir backend adresi (NEXT_PUBLIC_ prefix zorunlu)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true  → mock data kullan (backend hazır değilse)
# false → gerçek API'ye bağlan
NEXT_PUBLIC_USE_MOCKS=true

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" veya "minio"
STORAGE_BACKEND=local

# MinIO (STORAGE_BACKEND=minio ise doldur)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pitchvision
MINIO_USE_SSL=false
