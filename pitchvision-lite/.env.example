# Backend
APP_NAME=PitchVision Lite API
DEBUG=false
SECRET_KEY=change-me-in-production

# PostgreSQL (Docker Compose varsayılanları ile uyumlu)
DATABASE_URL=postgresql+psycopg2://pitchvision:pitchvision@localhost:5432/pitchvision

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — virgülle ayrılmış origin listesi (boş = *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js — tarayıcıda kullanılır)
NEXT_PUBLIC_API_URL=http://localhost:8000
